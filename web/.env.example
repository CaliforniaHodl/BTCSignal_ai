# Copy to .env.local for development. Never commit real values.

# Database (omit locally to use embedded PGlite in .data/pglite)
DATABASE_URL=

# Cron + owner
CRON_SECRET=            # >= 32 chars; Vercel Cron sends it as a Bearer token
OWNER_EMAILS=           # comma-separated verified Gatekeep emails with owner rights
OWNER_SUBS=             # or Gatekeep subject ids

# Gatekeep (passkey SSO, OIDC)
GATEKEEP_ISSUER=http://localhost:8788
GATEKEEP_CLIENT_ID=btcsignal

# Lightning (LNbits on your node). Use the wallet's INVOICE key, never the admin key.
LNBITS_URL=
LNBITS_INVOICE_KEY=
LIGHTNING_MOCK=         # 1 = dev-only fake node (refused in production)

# Agent
ANTHROPIC_API_KEY=      # enables Claude review; without it the agent runs rules-only
AGENT_STARTING_CASH=10000
COINGECKO_API_KEY=      # optional
NEXT_PUBLIC_SITE_URL=https://btctradingsignalai.netlify.app
